#!name=Loon订阅解析器【鱼安】
#!desc=·专门用于解析订阅节点的插件\n·具体内容看arg参数\n·更适配普通机场，不支持特殊机场，请勿使用🤪
#!openUrl=https://nsloon.app
#!author=GPT
#!tag=解析器
#!system=
#!system_version=
#!loon_version=3.5.0(969)
#!homepage=https://nsloon.app
#!icon=https://raw.githubusercontent.com/Loon0x00/Loon0x00.github.io/main/static/img/loon.png
#!date=2026-10-17
#!type=parser

[Argument]
node = input,"",tag=批量导入本地节点,desc=URL填用不到的地址；例：https://www.baidu.com；这条是input，点开粘贴节点；不处理本地节点，保持这条为空
ua = input,"Loon",tag=拉取节点UA,desc=自定义；默认为Loon；拉取失败触发二次拉取节点才会带上ua
emoji = switch,false,tag=节点名添加emoji,desc= 已存在不会重复添加
twemoji = switch,false,tag=节点名处理台湾emoji
delemoji = switch,false,tag=节点名删除emoji
front = input,"",tag=⬇️节点名称,desc= 前面；关键字添加
behind = input,"",tag=节点名称⬇️,desc= 关键字添加；后面
del = input,"",tag=节点名称,desc=关键字删除；支持多个，英文逗号隔开；区分大小写
replace = input,"",tag=节点名称,desc=关键字替换；例：tw#台湾,香港#HK #连接，#后面替换前面，支持多个，英文逗号隔开；区分大小写
in = input,"",tag=保留节点,desc=关键字；支持多个，英文逗号隔开；区分大小写
out = input,"",tag=删除节点,desc=关键字；支持多个，英文逗号隔开；区分大小写
gpt = switch,false,tag=GPT检测,desc=检查通过的节点会在名称后面添加[GPT]；通过检测api来判断，效果不保证🤪
api = input,"",tag=GPT api,desc=测gpt必填api
timeout = input,"10",tag=脚本超时时间,desc=节点太多需延长时间，具体自测；单位为s
enabled = switch,true,tag=脚本开关
enabled2 = switch,false,tag=旧格式脚本开关,desc= 不支持新版脚本格式的关掉上面开关，启用这个

[Script]
generic then script("https://raw.githubusercontent.com/fishdown/Ggsddu/refs/heads/master/Js/loon-node-parser.js", {${node}, ${ua}, ${emoji}, ${twemoji}, ${delemoji}, ${front}, ${behind}, ${del}, ${replace}, ${in}, ${out}, ${gpt}, ${api}}) with tag="NodeParser", img_url="https://raw.githubusercontent.com/Loon0x00/Loon0x00.github.io/main/static/img/loon.png",timeout=${timeout},enable=${enabled}

generic script-path=https://raw.githubusercontent.com/fishdown/Ggsddu/refs/heads/master/Js/loon-node-parser.js,img-url=https://raw.githubusercontent.com/Loon0x00/Loon0x00.github.io/main/static/img/loon.png,timeout={timeout},enable={enabled2}, tag=NodeParser, argument=[{node},{ua},{emoji},{twemoji},{delemoji},{front},{behind},{del},{replace},{in},{out},{gpt},{api}]
